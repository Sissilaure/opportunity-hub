PORT=4000
NODE_ENV=development

# Base de données MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# TLS : trois cas selon le fournisseur MySQL.
# - Aiven (ou autre CA privée) : renseigner DB_CA_PATH (chemin local du .pem, dev)
#   ou DB_CA_CONTENT (contenu du certificat, prod/Render).
# - TiDB Cloud (ou autre fournisseur avec certificat reconnu, ex. Let's Encrypt) :
#   laisser DB_CA_PATH/DB_CA_CONTENT vides et mettre DB_SSL=true.
# - MySQL local sans TLS : laisser les trois vides.
DB_CA_PATH=
DB_CA_CONTENT=
DB_SSL=

# Session / auth espace équipe
SESSION_SECRET=

# Compte admin initial : créé automatiquement au premier démarrage si la table
# admin_user est vide. Sans effet ensuite (utiliser `npm run create-admin` après coup).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL du frontend (obligatoire en production pour que CORS + cookies fonctionnent)
FRONTEND_URL=http://localhost:5173

# Recherche intelligente (POST /api/recherche-ia) : clé gratuite sur aistudio.google.com
# (Get API key, aucune carte bancaire requise). Sans elle, la route renvoie une 503 claire
# et le reste de l'app fonctionne normalement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
